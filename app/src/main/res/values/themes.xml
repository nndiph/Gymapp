<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme only; the real theme is Compose Material 3 (core/theme). -->
    <style name="Theme.Liftverse" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!-- Launch theme of MainActivity (SplashScreen API via core-splashscreen). installSplashScreen() switches to
         postSplashScreenTheme. Light/dark come from values-night and drawable-night. IconBackground parent because
         the icon sits on a coloured circle. -->
    <style name="Theme.Liftverse.Starting" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">@color/window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/splash_icon_background</item>
        <item name="postSplashScreenTheme">@style/Theme.Liftverse</item>
    </style>
</resources>
